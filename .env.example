# --- Base de données (host-agnostique : Docker, Railway, Neon, Supabase…) ---
DATABASE_URL="postgres://nova_app:nova_app@localhost:5432/nova"

# --- API ---
API_PORT="4000"
JWT_SECRET="change-me-in-prod"          # signature des JWT (auth)

# --- IA de capture (choix du moteur, sans intermédiaire) ---
# AI_PROVIDER : claude | gemini | demo | (vide = auto : Claude si clé, sinon Gemini, sinon démo)
AI_PROVIDER=""
# Claude (recommandé) — extraction multimodale de pièces
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-haiku-4-5-20251001"
# Gemini (clé injectée automatiquement par AI Studio à l'exécution)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# --- Voix de Lexa (synthèse vocale TTS) ---
# Fournisseurs disponibles selon les clés présentes : ElevenLabs, OpenAI, xAI.
ELEVENLABS_API_KEY=""
OPENAI_API_KEY=""                        # sert aussi à la voix OpenAI
# xAI (Grok TTS) — en test. Français supporté (language: fr), MP3, ~90% moins cher.
XAI_API_KEY=""
XAI_TTS_VOICE=""                         # voix par défaut xAI (ex. eve, ara, luna…) ; vide = eve
# Test en aveugle : force TOUT le monde sur un fournisseur sans changer le choix
# stocké par dossier. Ex. TTS_FORCE_PROVIDER=xai pour comparer Grok à ElevenLabs.
TTS_FORCE_PROVIDER=""

# --- Divers ---
APP_URL="http://localhost:3000"
